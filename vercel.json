{
  "cleanUrls": true,
  "outputDirectory": "public",
  "rewrites": [
    {
      "source": "/assets/:match*",
      "destination": "/assets/:match*"
    },
    {
      "source": "/love/assets/:match*",
      "destination": "/assets/:match*"
    },
    {
      "source": "/love/style.css",
      "destination": "/style.css"
    },
    {
      "source": "/love/love.js",
      "destination": "/love.js"
    },
    {
      "source": "/love/:slug",
      "destination": "/love.html"
    },
    {
      "source": "/love",
      "destination": "/love.html"
    },
    {
      "source": "/buat",
      "destination": "/buat.html"
    },
    {
      "source": "/create",
      "destination": "/buat.html"
    }
  ]
}
